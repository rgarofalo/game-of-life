<div class="min-h-screen py-12 px-6 lg:px-8">
  <div class="mx-auto max-w-3xl text-center">
    <h1 class="text-3xl font-bold text-gray-900">Welcome to Game of Life</h1>
      
    <p class="mt-4 text-gray-700">Hello, <%= current_user.email %>! Ready to start a new game?</p>
    
    <div class="mt-6">
      <%= link_to "Start New Game", new_game_session_path, class: "inline-block bg-indigo-600 text-white font-medium rounded-md hover:bg-indigo-700", style: "padding: 12px 24px;" %>
    </div>
  </div>

  <div class="mx-auto max-w-3xl mt-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Your Game Sessions</h2>
    <%= render "game_sessions/table", game_sessions: @game_sessions %>
  </div>
</div>
