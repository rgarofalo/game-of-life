<% content_for :title, "Game sessions" %>

<div class="min-h-screen py-12 px-6 lg:px-8">
  <div class="mx-auto max-w-3xl">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
    <% end %>

    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold text-gray-900">Your Game Sessions</h1>
      <%= link_to "New Game", new_game_session_path, class: "rounded-md px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium" %>
    </div>

    <%= render "game_sessions/table", game_sessions: @game_sessions %>
  </div>
</div>
