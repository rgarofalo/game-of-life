<% if game_sessions.any? %>
  <table class="w-full border border-gray-300 rounded-md">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 border-b border-gray-300">ID</th>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 border-b border-gray-300">Status</th>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 border-b border-gray-300">Generation</th>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 border-b border-gray-300">Created At</th>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 border-b border-gray-300">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% game_sessions.each do |session| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-2 text-sm text-gray-900 border-b border-gray-200"><%= session.id.to_s[0..7] %>...</td>
          <td class="px-4 py-2 text-sm border-b border-gray-200">
            <span class="px-2 py-1 rounded-md text-xs font-medium 
              <%= session.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
              <%= session.status %>
            </span>
          </td>
          <td class="px-4 py-2 text-sm text-gray-900 border-b border-gray-200"><%= session.world&.number_generation || 0 %></td>
          <td class="px-4 py-2 text-sm text-gray-500 border-b border-gray-200"><%= session.created_at.strftime("%d/%m/%Y %H:%M") %></td>
          <td class="px-4 py-2 text-sm border-b border-gray-200">
            <%= link_to "View", game_session_path(session), class: "text-indigo-600 hover:text-indigo-500 font-medium" %>
            <%= link_to "Delete", game_session_path(session), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "ml-2 text-red-600 hover:text-red-500 font-medium" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-gray-500 text-center py-4">No game sessions yet. Start a new game!</p>
<% end %>
